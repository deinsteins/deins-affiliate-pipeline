[Unit]
Description=Deins Affiliate Pipeline (Telegram -> AI captions -> YT/FB/Threads)
After=network-online.target

[Service]
WorkingDirectory=/home/hatch/workspace/deins-affiliate-pipeline
ExecStart=/home/hatch/workspace/deins-affiliate-pipeline/.venv/bin/python -m src.main
EnvironmentFile=/home/hatch/workspace/deins-affiliate-pipeline/.env
Environment=NO_PROXY=localhost,127.0.0.1
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
