[Unit]
Description=Deins Affiliate Pipeline dashboard (review UI, port 8600)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hatch/workspace/deins-affiliate-pipeline
ExecStart=/home/hatch/workspace/deins-affiliate-pipeline/.venv/bin/python -m uvicorn src.dashboard:app --host 127.0.0.1 --port 8600
EnvironmentFile=/home/hatch/workspace/deins-affiliate-pipeline/.env
Environment=NO_PROXY=localhost,127.0.0.1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
