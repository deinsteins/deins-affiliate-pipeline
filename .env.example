# --- Telegram ingest (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=storage/telegram.session

# --- AI captions: own 9Router (OpenAI-compatible) ---
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=deepseek-chat

# --- YouTube Data API v3 (Google Cloud OAuth client) ---
YOUTUBE_CLIENT_SECRET_FILE=credentials-youtube.json
YOUTUBE_TOKEN_FILE=storage/youtube-token.json

# --- Facebook Page (Meta Graph API) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Threads API ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Notifications (Telegram bot via @BotFather; chat id of the owner) ---
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# --- Egress proxy (required in this sandbox) ---
HTTPS_PROXY=
